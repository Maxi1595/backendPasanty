// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}
  
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id          Int     @id @default(autoincrement())
  nombre      String
  correo      String  @unique
  contrasena  String
  verificado  Boolean? @default(false)
  token       String?
  foto        String?
  rol         Int

  empresa     Empresa?
  pasante     Pasante?
  admin       Admin?
}

model Admin {
  id          Int     @id @default(autoincrement())
  usuarioId   Int     @unique
  usuario     Usuario @relation(fields: [usuarioId], references: [id])
}

model Pasante {
  id                Int      @id @default(autoincrement())
  usuarioId         Int      @unique
  especialidad      String?
  estado            String   @default("disponible")
  direccion         String?
  estadoAcademico   String?
  cv                String?
  creadoEn          DateTime @default(now())

  postulante        Postulante[]
  usuario           Usuario      @relation(fields: [usuarioId], references: [id])
  perfilPasante     PerfilPasante?
}

model Empresa {
  id              Int      @id @default(autoincrement())
  usuarioId       Int      @unique
  direccion       String   @unique
  telefono        String
  especialidad    String
  creadoEn        DateTime @default(now())

  vacantes        Vacante[]
  usuario         Usuario   @relation(fields: [usuarioId], references: [id])
  perfilEmpresa   PerfilEmpresa?
}

model Vacante {
  id            Int      @id @default(autoincrement())
  titulo        String
  puesto        String?
  remuneracion  Boolean? @default(false)
  descripcion   String
  empresaId     Int
  empresa       Empresa  @relation(fields: [empresaId], references: [id])
  estado        String   @default("abierto")
  creadoEn      DateTime @default(now())

  postulante    Postulante[]
}

model Postulante {
  id          Int      @id @default(autoincrement())
  vacanteId   Int
  pasanteId   Int
  estado      String   @default("pendiente")
  fechaPost   DateTime @default(now())

  vacante     Vacante @relation(fields: [vacanteId], references: [id])
  pasante     Pasante @relation(fields: [pasanteId], references: [id])

  @@unique([vacanteId, pasanteId])
}

model PerfilPasante {
  id                    Int      @id @default(autoincrement())
  pasanteId             Int      @unique
  pasante               Pasante  @relation(fields: [pasanteId], references: [id])
  descripcion           String?
  linkedin              String?
  portfolio             String?
  habilidades           String?
  seccion1Titulo        String?
  seccion1Contenido     String?
  seccion2Titulo        String?
  seccion2Contenido     String?
  seccion3Titulo        String?
  seccion3Contenido     String?
}

model PerfilEmpresa {
  id                 Int      @id @default(autoincrement())
  empresaId          Int      @unique
  empresa            Empresa  @relation(fields: [empresaId], references: [id])
  banner             String?
  descripcion        String?
  historia           String?
  mision             String?
  vision             String?
  beneficios         String?
  sitioWeb           String?
  linkedin           String?
  cantidadEmpleados  String?
}